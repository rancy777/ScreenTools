<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <!-- The app is built separately. Avoid rebuilding its output while LensSnap is running. -->
    <Reference Include="ScreenTools">
      <HintPath>..\ScreenTools\ScreenTools\bin\$(Configuration)\net8.0-windows\ScreenTools.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>