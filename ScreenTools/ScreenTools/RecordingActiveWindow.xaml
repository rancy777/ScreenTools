<Window x:Class="ScreenTools.RecordingActiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Recording Active HUD"
        Width="1110"
        Height="286"
        MinWidth="1110"
        MinHeight="286"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    <Window.Resources>
        <DropShadowEffect x:Key="RecordingActiveHudShadow"
                          BlurRadius="34"
                          ShadowDepth="12"
                          Direction="270"
                          Color="#260F172A"
                          Opacity="1" />

        <Style x:Key="MeterSegmentStyle" TargetType="Border">
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="{StaticResource MeterTrackBrush}" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Border Width="958"
                Height="166"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,24,0,0"
                Padding="38,28,34,24"
                Background="#F5FFFFFF"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="28"
                Effect="{StaticResource RecordingActiveHudShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="263" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="28"
                             Height="28"
                             Margin="0,0,22,0"
                             Fill="{StaticResource LiveDotBrush}">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#33A4443E" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock x:Name="ElapsedTimeText"
                               VerticalAlignment="Center"
                               FontSize="58"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Text="00:12:45" />
                </StackPanel>

                <Border Grid.Column="1"
                        Width="1"
                        Margin="0,10"
                        Background="{StaticResource DividerBrush}" />

                <Grid Grid.Column="2" Margin="46,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                            <Canvas Width="22" Height="22">
                                <Path Fill="{StaticResource SecondaryIconBrush}"
                                      Data="M0,8.5H4.5L10.5,2.5V19.5L4.5,13.5H0Z M14.5,7C15.9,8 16.7,9.5 16.7,11C16.7,12.5 15.9,14 14.5,15V12.8C15.1,12.2 15.4,11.6 15.4,11C15.4,10.4 15.1,9.8 14.5,9.2Z M17.8,3.8C20.3,5.7 21.7,8.2 21.7,11C21.7,13.8 20.3,16.3 17.8,18.2V16C19.2,14.6 20,12.9 20,11C20,9.1 19.2,7.4 17.8,6Z" />
                            </Canvas>
                        </Viewbox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="44" Style="{StaticResource MeterSegmentStyle}" Background="{StaticResource MeterFillLightBrush}" />
                            <Border Width="48" Style="{StaticResource MeterSegmentStyle}" Background="{StaticResource MeterFillLightBrush}" />
                            <Border Width="22" Style="{StaticResource MeterSegmentStyle}" Background="#CFE0EC" />
                            <Border Width="60" Style="{StaticResource MeterSegmentStyle}" />
                            <Border Width="58" Style="{StaticResource MeterSegmentStyle}" Margin="0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="17" Height="25" VerticalAlignment="Center">
                            <Canvas Width="17" Height="25">
                                <Path Fill="{StaticResource SecondaryIconBrush}"
                                      Data="M8.5,16.5C11.1,16.5 13.1,14.4 13.1,11.9V4.6C13.1,2 11.1,0 8.5,0C5.9,0 3.8,2 3.8,4.6V11.9C3.8,14.4 5.9,16.5 8.5,16.5Z M0,11.1H2C2,14.5 4.6,17.3 8.1,17.7V21.5H6.1V23.5H10.9V21.5H8.9V17.7C12.4,17.3 15,14.5 15,11.1H17C17,15.3 13.8,18.8 9.6,19.4H7.4C3.2,18.8 0,15.3 0,11.1Z" />
                            </Canvas>
                        </Viewbox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="78" Style="{StaticResource MeterSegmentStyle}" Background="{StaticResource MeterFillBrush}" />
                            <Border Width="56" Style="{StaticResource MeterSegmentStyle}" Background="{StaticResource MeterFillBrush}" />
                            <Border Width="26" Style="{StaticResource MeterSegmentStyle}" Background="#A6C5DE" />
                            <Border Width="20" Style="{StaticResource MeterSegmentStyle}" Background="#D7E2EA" />
                            <Border Width="18" Style="{StaticResource MeterSegmentStyle}" Margin="0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,0,0,0">
                        <TextBlock x:Name="ActiveAudioSummaryText"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryIconBrush}"
                                   Text="麦克风 关闭 · 系统声音 关闭" />
                        <TextBlock x:Name="ActiveOutputSummaryText"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryIconBrush}"
                                   Text="1080P 60FPS · 输出到 LensSnap" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="PauseButton"
                      Grid.Column="3"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Cursor="Hand"
                      MouseLeftButtonUp="PauseResume_Click">
                    <Ellipse Width="48" Height="48" Stroke="#313A3E" StrokeThickness="5" Fill="Transparent" />
                    <Rectangle x:Name="PauseLeftBar" Width="6" Height="18" Fill="#313A3E" RadiusX="2" RadiusY="2" HorizontalAlignment="Center" Margin="-6,0,0,0" />
                    <Rectangle x:Name="PauseRightBar" Width="6" Height="18" Fill="#313A3E" RadiusX="2" RadiusY="2" HorizontalAlignment="Center" Margin="10,0,0,0" />
                </Grid>

                <Border Grid.Column="4"
                        Width="78"
                        Height="78"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource StopButtonBgBrush}"
                        CornerRadius="26"
                        Cursor="Hand"
                        MouseLeftButtonUp="StopRecording_Click">
                    <Grid>
                        <Ellipse Width="42" Height="42" Fill="{StaticResource StopButtonFillBrush}" />
                        <Rectangle Width="16" Height="16" Fill="White" RadiusX="2" RadiusY="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Grid Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SecondaryIconBrush}" Margin="0,-18,0,0" VerticalAlignment="Center" />
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SecondaryIconBrush}" VerticalAlignment="Center" />
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SecondaryIconBrush}" Margin="0,18,0,0" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
