<Window x:Class="ScreenTools.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Region Selection"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#22000000"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseMove="Window_MouseMove">
    <Canvas>
        <Rectangle x:Name="SelectionRect"
                   Stroke="#FF005EB1"
                   StrokeThickness="2"
                   Fill="#11FFFFFF"
                   Visibility="Collapsed" />
        <Border x:Name="HintBadge"
                Canvas.Left="24"
                Canvas.Top="24"
                Padding="12,8"
                Background="#EEFFFFFF"
                CornerRadius="10">
            <StackPanel>
                <TextBlock FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FF2D3435"
                           Text="拖拽选择截图区域" />
                <TextBlock x:Name="HintText"
                           Margin="0,2,0,0"
                           FontSize="11"
                           Foreground="#FF5F6B7A"
                           Text="松开鼠标完成，Esc 取消" />
            </StackPanel>
        </Border>
        <Border x:Name="InspectorBadge"
                Width="168"
                Padding="10"
                Background="#F4FFFFFF"
                BorderBrush="#22005EB1"
                BorderThickness="1"
                CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="4"
                                  Direction="270"
                                  Color="#220F172A"
                                  Opacity="0.9" />
            </Border.Effect>
            <StackPanel>
                <Border Height="72"
                        CornerRadius="8"
                        BorderBrush="#18000000"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Image x:Name="MagnifierImage"
                           Stretch="Fill"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
                <TextBlock x:Name="PositionText"
                           Margin="0,8,0,0"
                           FontSize="11"
                           Foreground="#FF2D3435"
                           Text="X: 0  Y: 0" />
                <TextBlock x:Name="ColorText"
                           Margin="0,2,0,0"
                           FontSize="11"
                           Foreground="#FF2D3435"
                           Text="RGB: 0, 0, 0" />
                <StackPanel Margin="0,6,0,0"
                            Orientation="Horizontal">
                    <Border x:Name="ColorPreview"
                            Width="16"
                            Height="16"
                            Margin="0,0,6,0"
                            BorderBrush="#22000000"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="#FFFFFFFF" />
                    <TextBlock x:Name="HexText"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#FF5F6B7A"
                               Text="#FFFFFF" />
                </StackPanel>
                <TextBlock x:Name="SelectionSizeText"
                           Margin="0,6,0,0"
                           FontSize="11"
                           Foreground="#FF005EB1"
                           Text="未开始框选" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
