<Window x:Class="ScreenTools.ScreenshotStickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screenshot Sticker"
        Width="460"
        Height="320"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True">
    <Border Background="#F4FFFFFF"
            BorderBrush="#22000000"
            BorderThickness="1"
            CornerRadius="16"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="6"
                              Direction="270"
                              Color="#220F172A"
                              Opacity="0.9" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="12,10,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#FF2D3435"
                               Text="截图贴纸" />
                    <Border Margin="10,0,0,0"
                            Padding="8,2"
                            Background="#11005EB1"
                            CornerRadius="8">
                        <TextBlock FontSize="10"
                                   Foreground="#FF005EB1"
                                   Text="置顶" />
                    </Border>
                    <TextBlock x:Name="ZoomText"
                               Margin="10,0,0,0"
                               FontSize="12"
                               Foreground="#FF5F6B7A"
                               Text="100%" />
                    <TextBlock x:Name="OpacityText"
                               Margin="10,0,0,0"
                               FontSize="12"
                               Foreground="#FF5F6B7A"
                               Text="100%" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Width="40"
                            Height="28"
                            Margin="0,0,6,0"
                            Click="CopyButton_Click"
                            Content="复制"
                            FontSize="11"
                            Background="#11000000"
                            BorderThickness="0"
                            Foreground="#FF2D3435"
                            Cursor="Hand" />
                    <Button Width="48"
                            Height="28"
                            Margin="0,0,6,0"
                            Click="SaveAsButton_Click"
                            Content="另存为"
                            FontSize="10"
                            Background="#11000000"
                            BorderThickness="0"
                            Foreground="#FF2D3435"
                            Cursor="Hand" />
                    <Button Width="40"
                            Height="28"
                            Margin="0,0,6,0"
                            Click="OpacityButton_Click"
                            Content="透明"
                            FontSize="11"
                            Background="#11000000"
                            BorderThickness="0"
                            Foreground="#FF2D3435"
                            Cursor="Hand" />
                    <Button Width="48"
                            Height="28"
                            Margin="0,0,6,0"
                            Click="CloseAllButton_Click"
                            Content="关闭全部"
                            FontSize="10"
                            Background="#11000000"
                            BorderThickness="0"
                            Foreground="#FF2D3435"
                            Cursor="Hand" />
                    <Button Width="28"
                            Height="28"
                            Click="CloseButton_Click"
                            Content="×"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Background="#11000000"
                            BorderThickness="0"
                            Foreground="#FF2D3435"
                            Cursor="Hand" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Margin="10,0,10,10"
                    ClipToBounds="True"
                    CornerRadius="12"
                    Background="#08FFFFFF">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel">
                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="ImageScaleTransform"
                                            ScaleX="1"
                                            ScaleY="1" />
                        </Image.RenderTransform>
                    </Image>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
