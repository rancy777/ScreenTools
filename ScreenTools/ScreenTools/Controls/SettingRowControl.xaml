<UserControl x:Class="ScreenTools.Controls.SettingRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignHeight="56"
             d:DesignWidth="720">
    <Grid x:Name="RowLayout" SizeChanged="RowLayout_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="TextContent" Grid.Column="0" MinWidth="0">
            <TextBlock Style="{StaticResource BodyTitleTextStyle}"
                       Text="{Binding Title, ElementName=Root}"
                       TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource BodyDescriptionTextStyle}"
                       Text="{Binding Description, ElementName=Root}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ContentPresenter x:Name="RightContentPresenter" Grid.Column="1"
                          VerticalAlignment="Center"
                          Margin="{Binding RightContentMargin, ElementName=Root}"
                          Content="{Binding RightContent, ElementName=Root}" />
    </Grid>
</UserControl>
