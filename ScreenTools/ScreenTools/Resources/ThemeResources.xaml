<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="UiFontFamily">Anthropic Sans, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="LatinUiFontFamily">Anthropic Sans, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoUiFontFamily">Cascadia Mono, Consolas</FontFamily>

    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F9F9F9" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#F2F4F4" />
    <SolidColorBrush x:Key="FloatingOverlayBrush" Color="#F0FFFFFF" />
    <SolidColorBrush x:Key="PanelFillBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="ComboBrush" Color="#DDE4E5" />
    <SolidColorBrush x:Key="PanelBrush" Color="#E4E9EA" />
    <SolidColorBrush x:Key="ChipBrush" Color="#EEF1F2" />
    <SolidColorBrush x:Key="ComboSurfaceBrush" Color="#F5F7F7" />
    <SolidColorBrush x:Key="KeycapBrush" Color="#F6F8F8" />
    <SolidColorBrush x:Key="KeycapInnerBrush" Color="#FCFDFD" />
    <SolidColorBrush x:Key="SecondaryActionBrush" Color="#F4F7F7" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="#005EB1" />
    <SolidColorBrush x:Key="PrimaryActiveBrush" Color="#00529B" />
    <SolidColorBrush x:Key="ToolbarPrimaryBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="PrimaryPaleBrush" Color="#D5E3FF" />

    <SolidColorBrush x:Key="HeadingBrush" Color="#2D3435" />
    <SolidColorBrush x:Key="TextBrush" Color="#2D3435" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1E2A44" />
    <SolidColorBrush x:Key="BodyBrush" Color="#5A6061" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#4F5658" />
    <SolidColorBrush x:Key="MutedBrush" Color="#ADB3B4" />
    <SolidColorBrush x:Key="SlateBrush" Color="#5F6B7A" />
    <SolidColorBrush x:Key="TopbarTextBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TopbarIconBrush" Color="#64748B" />
    <SolidColorBrush x:Key="BottomBarIconBrush" Color="#475569" />
    <SolidColorBrush x:Key="BottomIconBrush" Color="#435063" />
    <SolidColorBrush x:Key="SecondaryIconBrush" Color="#5F6A72" />
    <SolidColorBrush x:Key="BadgeBrush" Color="#5D5F65" />

    <SolidColorBrush x:Key="DividerBrush" Color="#26B3B9BA" />
    <SolidColorBrush x:Key="SoftBorderBrush" Color="#33ADB3B4" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#14AAB1B2" />
    <SolidColorBrush x:Key="ToolbarHairlineBrush" Color="#22D7DDE2" />
    <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#33E2E8F0" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#26D9DFE5" />

    <SolidColorBrush x:Key="TrackOffBrush" Color="#B3B9BA" />
    <SolidColorBrush x:Key="TrackOffSoftBrush" Color="#C5CBCC" />
    <SolidColorBrush x:Key="ToggleThumbBorderBrush" Color="#D7DDDE" />
    <SolidColorBrush x:Key="LiveDotBrush" Color="#A4443E" />
    <SolidColorBrush x:Key="MeterTrackBrush" Color="#D7E2EA" />
    <SolidColorBrush x:Key="MeterFillBrush" Color="#1D6EB6" />
    <SolidColorBrush x:Key="MeterFillLightBrush" Color="#7DAED4" />
    <SolidColorBrush x:Key="StopButtonBgBrush" Color="#F2EAEA" />
    <SolidColorBrush x:Key="StopButtonFillBrush" Color="#B14A45" />

    <DropShadowEffect x:Key="SegmentShadowEffect"
                      BlurRadius="4"
                      Direction="270"
                      ShadowDepth="1"
                      Color="#0D000000"
                      Opacity="1" />

    <DropShadowEffect x:Key="FloatingBarShadowEffect"
                      BlurRadius="12"
                      Direction="270"
                      ShadowDepth="3"
                      Color="#120F172A"
                      Opacity="0.35" />

    <DropShadowEffect x:Key="HudShadow"
                      BlurRadius="18"
                      ShadowDepth="4"
                      Direction="270"
                      Color="#160F172A"
                      Opacity="0.45" />

    <DropShadowEffect x:Key="ButtonShadow"
                      BlurRadius="8"
                      ShadowDepth="1"
                      Direction="270"
                      Color="#26005EB1"
                      Opacity="0.85" />

    <DropShadowEffect x:Key="SoftPanelShadow"
                      BlurRadius="8"
                      ShadowDepth="2"
                      Direction="270"
                      Color="#140F172A"
                      Opacity="0.35" />

    <DropShadowEffect x:Key="InsetSoftShadow"
                      BlurRadius="8"
                      ShadowDepth="1"
                      Direction="270"
                      Color="#100F172A"
                      Opacity="0.7" />

    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">16</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">28</CornerRadius>

    <Style x:Key="SurfaceCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    </Style>

    <Style x:Key="FloatingGlassBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FloatingOverlayBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ToolbarHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect" Value="{StaticResource HudShadow}" />
    </Style>

    <Style x:Key="PanelGlassBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
        <Setter Property="Effect" Value="{StaticResource HudShadow}" />
    </Style>

    <Style x:Key="ChipBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ChipBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    </Style>

    <Style x:Key="SecondaryPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SecondaryActionBrush}" />
        <Setter Property="BorderBrush" Value="#20AAB1B2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    </Style>

    <Style x:Key="PrimaryActionButtonStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Effect" Value="{StaticResource ButtonShadow}" />
    </Style>

    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource HeadingBrush}" />
    </Style>

    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource BodyBrush}" />
    </Style>

    <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource HeadingBrush}" />
    </Style>

    <Style x:Key="BodyTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource HeadingBrush}" />
    </Style>

    <Style x:Key="BodyDescriptionTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource BodyBrush}" />
    </Style>

    <Style x:Key="MonoBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoUiFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BareToggleBaseStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="LinkActionButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="Background" Value="{StaticResource SecondaryActionBrush}" />
        <Setter Property="BorderBrush" Value="#20AAB1B2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource HeadingBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSmall}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <ContentPresenter Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       FontSize="10"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="&#xE72A;" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#F8FAFA" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#30005EB1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#EDF3F5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TopNavIconButtonStyle" TargetType="Border">
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="SegmentButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource BodyBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="SelectionBorder"
                            Padding="18,8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSmall}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SelectionBorder" Property="Background" Value="#99FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SelectionBorder" Property="Background" Value="{StaticResource SecondaryActionBrush}" />
                            <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#26005EB1" />
                            <Setter TargetName="SelectionBorder" Property="Effect" Value="{StaticResource SoftPanelShadow}" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Foreground" Value="{StaticResource HeadingBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Margin="4,2"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusSmall}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#12005EB1" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#1A005EB1" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryActiveBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Width" Value="132" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="{StaticResource ComboSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource HeadingBrush}" />
        <Setter Property="BorderBrush" Value="#24AAB1B2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,0,34,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="ComboBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True"
                                CornerRadius="{StaticResource RadiusSmall}">
                            <Grid>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                <Border Width="24"
                                        Margin="0,4,6,4"
                                        HorizontalAlignment="Right"
                                        Background="#0D0F172A"
                                        CornerRadius="4">
                                    <Path Width="8.4"
                                          Height="4.2"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Stroke="#5F6B7A"
                                          StrokeThickness="1.35"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M 0 0 L 4.2 4.2 L 8.4 0" />
                                </Border>
                            </Grid>
                        </Border>
                        <ToggleButton Background="Transparent"
                                      BorderThickness="0"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border Width="{TemplateBinding ActualWidth}"
                                    Margin="0,6,0,0"
                                    Background="{StaticResource PanelFillBrush}"
                                    BorderBrush="{StaticResource HairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMedium}"
                                    Effect="{StaticResource SoftPanelShadow}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#4D005EB1" />
                            <Setter TargetName="ComboBorder" Property="Background" Value="#F7FAFB" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ComboBorder" Property="Background" Value="#F8FAFA" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BottomToolItemTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LatinUiFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource BottomBarIconBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="BottomToolLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LatinUiFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource BottomIconBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
